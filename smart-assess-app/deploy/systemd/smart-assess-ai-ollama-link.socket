# SMART ASSESS - the AI worker's only connection to Ollama: a Unix socket forwarded to 127.0.0.1:11434.
# NOT INSTALLED. Install (with approval) with smart-assess-ai-ollama-link.service:
#   sudo install -o root -g root -m 0644 smart-assess-ai-ollama-link.socket smart-assess-ai-ollama-link.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now smart-assess-ai-ollama-link.socket
# the AI worker's PHP-FPM pool runs with PrivateNetwork=yes (no network at all, so flushing or breaking the host firewall can never
# open anything to it). This socket file is its only way out: group sa-ai-worker only, and the forwarder behind it
# can connect to 127.0.0.1:11434 and nowhere else.
[Unit]
Description=SMART ASSESS link for the AI worker's PHP-FPM pool (Unix socket to 127.0.0.1:11434)

[Socket]
ListenStream=/run/smart-assess-ai-ollama/ollama.sock
SocketUser=root
SocketGroup=sa-ai-worker
SocketMode=0660
DirectoryMode=0755
Accept=no

[Install]
WantedBy=sockets.target
