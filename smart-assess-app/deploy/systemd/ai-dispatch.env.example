# /etc/smart-assess/ai-dispatch.env - settings for the AI dispatcher ONLY.
#
# A separate file on purpose:
#  - systemd needs plain KEY=VALUE lines; it cannot read Apache "SetEnv" lines,
#    and /etc/smart-assess/apache.env may use that format.
#  - the worker secret and the dispatcher's own database password are not given
#    to Apache or PHP web requests.
# Owner root:root, mode 0600 (systemd reads it as root, then starts the service as
# sa-ai-dispatch). Never commit the real file. No spaces around "=". Values must
# not contain quotes or "$".
#
# DB_HOST, DB_PORT, DB_NAME and DB_USER are required: the dispatcher refuses to
# start without them, so it never falls back to a default database.

# The website connects through the local socket (production: DB_HOST=localhost,
# DB_PORT=3306). Keep "localhost": it uses the Unix socket, which the service's
# loopback-only network setting does not affect, and it matches the
# 'smart_assess_ai_dispatch'@'localhost' account.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_assess_sydney
# The dispatcher's own least-privilege account (deploy/mysql/ai-dispatch-db-user.sql.example),
# NOT the website's account.
DB_USER=smart_assess_ai_dispatch
SMART_ASSESS_DB_PASS=<the password set for smart_assess_ai_dispatch>

# The local AI worker installed in Steps 4-5: lighttpd on loopback in front of the
# worker's PHP-FPM pool. Plain HTTP is accepted only for a loopback address, so no
# CA file is needed (leave SMART_ASSESS_AI_WORKER_CA_FILE unset).
SMART_ASSESS_AI_WORKER_URL=http://127.0.0.1:8095
# The dispatcher has no network (PrivateNetwork=yes): its unit sets
# SMART_ASSESS_AI_WORKER_SOCKET=/run/smart-assess-ai-link/worker.sock, so requests to the URL above go
# through that socket file (smart-assess-ai-worker-link.socket). Do not override it here.
# At least 32 characters; the same value as SMART_ASSESS_WORKER_SECRET in
# /etc/smart-assess-ai-worker/worker.env. Copy it root to root; never print it.
SMART_ASSESS_AI_WORKER_SECRET=<the worker's shared secret>
# Seconds the dispatcher waits for one job (60-1800). The worker is told to answer
# within TIMEOUT - min(120, TIMEOUT/4) seconds; the job is leased for TIMEOUT + 120 s.
# The worker allows at most 900 s per job, and its HTTP front (lighttpd, 1080 s) and
# PHP-FPM (1020 s) wait longer than that.
SMART_ASSESS_AI_WORKER_TIMEOUT=900
# Only for a worker on another server over HTTPS with a private CA (not the local worker):
# SMART_ASSESS_AI_WORKER_CA_FILE=/etc/smart-assess/ai-worker-ca.pem

# The date and time the reviewed Privacy Policy that describes the AI check took
# effect, with its offset, e.g. in the format YYYY-MM-DDTHH:MM:SS+08:00. Only
# requests submitted at or after it are checked. Required: without a valid
# value the dispatcher refuses to run (exit code 2) and nothing is checked.
# Set the SAME value for the website (see docs, "Privacy Policy effective date").
SMART_ASSESS_AI_PRIVACY_EFFECTIVE_AT=<confirmed Privacy Policy effective date and time, YYYY-MM-DDTHH:MM:SS+08:00>
