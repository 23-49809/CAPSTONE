# /etc/smart-assess/ai-dispatch.env - settings for the AI dispatcher ONLY.
#
# A separate file on purpose:
#  - systemd needs plain KEY=VALUE lines; it cannot read Apache "SetEnv" lines,
#    and /etc/smart-assess/apache.env may use that format.
#  - the worker secret is not given to Apache or PHP web requests.
# Owner root:root, mode 0600 (systemd reads it as root). Never commit the real
# file. No spaces around "=". Values must not contain quotes or "$".
#
# Copy the database values from the web application's settings
# (/etc/smart-assess/apache.env). DB_HOST, DB_PORT, DB_NAME and DB_USER are
# required: the dispatcher refuses to start without them, so it never falls
# back to a default database.

# Use exactly the web application's DB_HOST. MySQL matches accounts by how you
# connect: "localhost" uses the Unix socket and matches 'user'@'localhost';
# "127.0.0.1" uses TCP and may NOT match a 'user'@'localhost' account (for
# example with skip_name_resolve). Both work under the service's read-only
# sandbox (the socket stays reachable; AF_UNIX is allowed).
DB_HOST=<the web application's DB_HOST>
# Confirm the port in the readiness report (section 5); the application's built-in default is 3307.
DB_PORT=<the web application's DB_PORT>
DB_NAME=smart_assess_sydney
DB_USER=<the web application's DB_USER>
SMART_ASSESS_DB_PASS=<the web application's database password>

# The worker's private HTTPS address (no path), e.g. https://10.0.1.25:8443
SMART_ASSESS_AI_WORKER_URL=https://<worker private IP>:8443
# At least 32 characters; the same value as SMART_ASSESS_WORKER_SECRET on the worker.
# Generate once with: openssl rand -hex 32
SMART_ASSESS_AI_WORKER_SECRET=<shared secret>
# Seconds the dispatcher waits for one job (60-1800). The worker is told to answer
# within TIMEOUT - min(120, TIMEOUT/4) seconds; the job is leased for TIMEOUT + 120 s.
SMART_ASSESS_AI_WORKER_TIMEOUT=900
# The private CA certificate that signed the worker's HTTPS certificate (root:www-data 0640).
SMART_ASSESS_AI_WORKER_CA_FILE=/etc/smart-assess/ai-worker-ca.pem

# The date and time the reviewed Privacy Policy that describes the AI check took
# effect, with its offset, e.g. in the format YYYY-MM-DDTHH:MM:SS+08:00. Only
# requests submitted at or after it are checked. Required: without a valid
# value the dispatcher refuses to run (exit code 2) and nothing is checked.
# Set the SAME value for the website (see docs, "Privacy Policy effective date").
SMART_ASSESS_AI_PRIVACY_EFFECTIVE_AT=<confirmed Privacy Policy effective date and time, YYYY-MM-DDTHH:MM:SS+08:00>
